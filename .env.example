# Board server
STELLARIS_DATA_DIR=./data
STELLARIS_HOST=127.0.0.1
STELLARIS_PORT=4700
STELLARIS_LOG_LEVEL=info

# User token: minted by `stellaris init`, printed once. Never commit the real value.
STELLARIS_USER_TOKEN=replace-me

# Agent CLI credentials on the runner machine. Leave empty to use the CLIs' own login state.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
