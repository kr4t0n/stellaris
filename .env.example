# Board server
STELLARIS_DATA_DIR=./data
STELLARIS_HOST=127.0.0.1
STELLARIS_PORT=4700
STELLARIS_LOG_LEVEL=info
# A second port that serves Prometheus's turn and token counters at /metrics; empty serves none.
STELLARIS_METRICS_PORT=

# Agent CLI credentials on the runner machine. Leave empty to use the CLIs' own login state.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
