  "delimited": [
    {
      "name": "quotes hold separators, line breaks and doubled quotes",
      "text": "name,note\r\nada,\"says \"\"hi\"\", twice\"\nref,\"two\nlines\"\n",
      "separator": ",",
      "rows": [
        ["name", "note"],
        ["ada", "says \"hi\", twice"],
        ["ref", "two\nlines"]
      ]
    },
    {
      "name": "tabs, a last field empty",
      "text": "a\tb\n1\t",
      "separator": "\t",
      "rows": [
        ["a", "b"],
        ["1", ""]
      ]
    },
    {
      "name": "nothing",
      "text": "",
      "separator": ",",
      "rows": []
    },
    {
      "name": "one row with no line end",
      "text": "a,b",
      "separator": ",",
      "rows": [["a", "b"]]
    },
    {
      "name": "one row with a line end",
      "text": "a,b\n",
      "separator": ",",
      "rows": [["a", "b"]]
    },
    {
      "name": "a last field empty before a line end",
      "text": "a,\n",
      "separator": ",",
      "rows": [["a", ""]]
    },
    {
      "name": "a line end alone",
      "text": "\n",
      "separator": ",",
      "rows": [[""]]
    },
    {
      "name": "CR alone ends a row",
      "text": "a\r\rb",
      "separator": ",",
      "rows": [["a"], [""], ["b"]]
    },
    {
      "name": "a quote inside a field is kept",
      "text": "x\"y,z",
      "separator": ",",
      "rows": [["x\"y", "z"]]
    },
    {
      "name": "text after a closing quote joins the field",
      "text": "\"a\"b,c",
      "separator": ",",
      "rows": [["ab", "c"]]
    },
    {
      "name": "a quote never closed runs to the end",
      "text": "\"open,x\ny",
      "separator": ",",
      "rows": [["open,x\ny"]]
    },
    {
      "name": "two empty quoted fields",
      "text": "\"\",\"\"",
      "separator": ",",
      "rows": [["", ""]]
    },
    {
      "name": "letters past ASCII and emoji",
      "text": "é,😀\r\n1,2",
      "separator": ",",
      "rows": [
        ["é", "😀"],
        ["1", "2"]
      ]
    },
    {
      "name": "a comma in a TSV is text",
      "text": "a,b\tc",
      "separator": "\t",
      "rows": [["a,b", "c"]]
    }
  ],
  "lines": [
