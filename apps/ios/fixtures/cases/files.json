      "lines": [""]
    },
    {
      "name": "two LFs",
      "text": "\n\n",
      "lines": ["", ""]
    },
    {
      "name": "CRLF keeps its CR on each line",
      "text": "a\r\nb\r\n",
      "lines": ["a\r", "b\r"]
    },
    {
      "name": "a blank line between",
      "text": "a\n\nb",
      "lines": ["a", "", "b"]
    },
    {
      "name": "CR alone is no line end",
      "text": "a\rb",
      "lines": ["a\rb"]
    },
    {
      "name": "emoji and letters past ASCII",
      "text": "😀\né\n",
      "lines": ["😀", "é"]
    }
