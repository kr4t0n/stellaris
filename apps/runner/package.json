{
  "name": "@stellaris/runner",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone runner daemon for machines other than the board server's",
  "bin": {
    "stellaris-runner": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@stellaris/adapter-claude": "workspace:*",
    "@stellaris/adapter-codex": "workspace:*",
    "@stellaris/runner-core": "workspace:*",
    "@stellaris/shared": "workspace:*",
    "pino": "10.3.1"
  }
}
