{
  "name": "@stellaris/server",
  "version": "0.0.0",
  "private": true,
  "description": "The board server: core library, scheduler, HTTP API, SSE feed, MCP endpoint, and the hub runners connect to; it runs no turns",
  "bin": {
    "stellaris-server": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@stellaris/board-core": "workspace:*",
    "@stellaris/board-mcp": "workspace:*",
    "@stellaris/runner-core": "workspace:*",
    "@stellaris/scheduler": "workspace:*",
    "@stellaris/shared": "workspace:*",
    "@stellaris/turn-host": "workspace:*",
    "execa": "10.0.1",
    "hono": "4.13.13",
    "pino": "10.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  }
}
